<UserControl x:Class="Minimal_Video_Editor.Clip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Minimal_Video_Editor"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             PreviewMouseMove="Clip_PreviewMouseMove"
             Drop="Clip_Drop" AllowDrop="True" PreviewDragOver="UserControl_PreviewDragOver" DragLeave="UserControl_DragLeave" MouseLeave="UserControl_MouseLeave">
    <Grid x:Name="MainGrid" Background="MediumPurple" >
        <Grid.RowDefinitions>
            <RowDefinition Height="80*"></RowDefinition>
            <RowDefinition Height="20*"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"></ColumnDefinition>
            <ColumnDefinition Width="1*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2"> <!--anteprime-->
            <StackPanel.LayoutTransform>
                <ScaleTransform ScaleX="{Binding InverseScaleX, RelativeSource={RelativeSource AncestorType=local:Timeline, AncestorLevel=1}}"></ScaleTransform>
            </StackPanel.LayoutTransform>
        </StackPanel>

        <Label x:Name="FilenameLabel" Grid.Row="1" Grid.ColumnSpan="2">
            <Label.LayoutTransform>
                <ScaleTransform ScaleX="{Binding InverseScaleX, RelativeSource={RelativeSource AncestorType=local:Timeline, AncestorLevel=1}}"></ScaleTransform>
            </Label.LayoutTransform>
        </Label>

        <Grid x:Name="ClipMovingDropSideLeftIndicatorGrid" Grid.RowSpan="2" Panel.ZIndex="10" Grid.Column="0" Visibility="Hidden" Background="DarkCyan" IsHitTestVisible="False" Opacity="0.5">
            
        </Grid>
        <Grid x:Name="ClipMovingDropSideRightIndicatorGrid" Grid.RowSpan="2" Panel.ZIndex="10" Grid.Column="1" Visibility="Hidden" Background="DarkCyan" IsHitTestVisible="False" Opacity="0.5">
            
        </Grid>

        <Grid x:Name="CutIndicatorGrid" Grid.RowSpan="2" Grid.ColumnSpan="2" Width="5" Margin="0,0,0,0" HorizontalAlignment="Left" Background="Black" Visibility="Hidden">
            <Grid.LayoutTransform>
                <ScaleTransform ScaleX="{Binding InverseScaleX, RelativeSource={RelativeSource AncestorType=local:Timeline, AncestorLevel=1}}"></ScaleTransform>
            </Grid.LayoutTransform>
        </Grid>
    </Grid>
</UserControl>
